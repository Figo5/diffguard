{
  "name": "@figo5/diffguard",
  "version": "0.1.0",
  "description": "Audit code changes for security issues and unintended behavior changes using your own Anthropic API key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Figo5/diffguard.git"
  },
  "type": "module",
  "bin": {
    "diffguard": "bin/diffguard"
  },
  "files": ["dist", "bin"],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "cli": "node bin/diffguard",
    "start": "node dist/cli/main.js",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
